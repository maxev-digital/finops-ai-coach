# Anthropic — LLM generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — embeddings only (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# PostgreSQL + pgvector
# Local dev: postgresql+asyncpg://finops:finops_dev@localhost:5432/finops
# VPS:       postgresql+asyncpg://finops_coach:PASSWORD@localhost:5445/finops_coach
DATABASE_URL=postgresql+asyncpg://finops:finops_dev@localhost:5432/finops

# Redis — embedding cache (optional, degrades gracefully if not set)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
